# Clave usada para firmar los JWT (HS256). Generar una nueva con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes
# Minutos de vigencia del access token
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Origenes autorizados para CORS, separados por coma. Nunca usar "*" con allow_credentials=True
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
